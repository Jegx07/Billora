# Billora Environment Configuration
# For Local Zero-Daemon Persistent DB: file:./dev.db
# For Supabase PostgreSQL (Transaction Pooler - Port 6543):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
DATABASE_URL="file:./dev.db"
DIRECT_URL=""
POSTGRES_DATABASE_URL="postgresql://billora:billora_secret_password@localhost:5432/billora_db?schema=public"

# ---------------------------------------------------------------------------
# Centralized Supabase Configuration (Database, Auth, RLS & Storage)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Optional newer Supabase publishable key format (supported automatically if anon key is omitted)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=""
# Server-only secret key — NEVER expose in client-side code or commit real keys
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# Supabase Storage Private Buckets
SUPABASE_STORAGE_BUCKET_INVOICES="invoice-documents"
SUPABASE_STORAGE_BUCKET_CUSTOMERS="customer-documents"
SUPABASE_STORAGE_BUCKET_PROFILES="profile-images"

# Redis / BullMQ Background Queue
REDIS_URL="redis://localhost:6379"

# Application & Business Settings
NEXT_PUBLIC_APP_NAME="Billora"
NEXT_PUBLIC_APP_TAGLINE="Every Subscription. One Intelligent Platform."
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BUSINESS_TIMEZONE="Asia/Kolkata"
SESSION_SECRET="billora-super-secret-hmac-key-2026-production-grade-998877"

# Razorpay Payment Gateway (Test Mode Keys)
RAZORPAY_KEY_ID="rzp_test_BilloraKeyId001"
RAZORPAY_KEY_SECRET="rzp_test_BilloraSecretKey99887766"
RAZORPAY_WEBHOOK_SECRET="whsec_BilloraWebhookSecret11223344"

# Resend Email Notifications
RESEND_API_KEY="re_test_billora_key"
EMAIL_FROM="billing@billora.io"

# Google Gemini AI Assistant
# Obtain API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash"
